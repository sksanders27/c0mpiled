# --- Vapi ---
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# --- Public URL (fill in your ngrok static domain, without https://) ---
NGROK_DOMAIN=
PUBLIC_BASE_URL=

# --- LLM through Vapi (no separate key needed; verify model ids in the Vapi docs) ---
VOICE_MODEL_PROVIDER=openai
VOICE_MODEL=gpt-4o-mini

# --- Teammates acting as response units ---
UNIT_PHONE_1=
UNIT_PHONE_2=
UNIT_PHONE_3=

# --- Backend integration ---
BACKEND_BASE_URL=
AIRCRAFT_MODE=mock
ALLOW_AIRCRAFT_FALLBACK=1
OFFLINE_VOICE=1
API_TOKEN=
MAX_ATTEMPTS_PER_TYPE=3
MAX_TOTAL_ATTEMPTS=4
ASSIGNMENT_TIMEOUT_SECONDS=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Modes ---
MOCK_DISPATCH=0
SIM_UNITS=1
SCRIPTED_DECLINE_FIRST=0
UNIT_CALL_TIMEOUT_S=45
MAX_OUTBOUND_CALLS=4
SIM_UNIT_DELAY_S=4

# --- Integrated backend (uvicorn main:app --workers 1) ---
# OFFLINE_VOICE=1 rehearses both legs without Vapi network requests or credits.
# Set OFFLINE_VOICE=0 for actual pilot speech; keep SIM_UNITS=1 for simulated units.
OFFLINE_VOICE=1
AIRCRAFT_MODE=mock
ALLOW_AIRCRAFT_FALLBACK=true
MAX_ATTEMPTS_PER_TYPE=3
MAX_TOTAL_ATTEMPTS=4
# Optional callback backstop. Default is UNIT_CALL_TIMEOUT_S + 1 second.
ASSIGNMENT_TIMEOUT_SECONDS=
API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
